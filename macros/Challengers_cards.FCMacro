import FreeCAD as App
import Part
from math import sqrt, pi
from dataclasses import dataclass
import itertools

# =====================
# PARAMETERS
# =====================

# printer
MAX_WIDTH = 220
MAX_DEPTH = 220
MAX_HEIGHT = 220

# MAGNETS
MAGNET_CLEARANCE = 0.3
MAGNET_RADIUS = 3 + MAGNET_CLEARANCE
MAGNET_HEIGHT = 3 + MAGNET_CLEARANCE

# Tray
SEPERATOR_WIDTH = 1.5
BOTTOM_THICKNESS = 1.5
OUTER_WALL_DEPTH = MAGNET_HEIGHT + 1

# card dimensions
CARD_CLEARANCE = 1.3
CARD_WIDTH = 89.0 + CARD_CLEARANCE
CARD_HEIGHT = 64.0 + CARD_CLEARANCE
CARD_DEPTHS = [36, 36, 26, 16, 3, 8] # A, B, C cards, start decks, gameplay
CARD_DEPTHS = [d + CARD_CLEARANCE for d in CARD_DEPTHS]
CARD_ACCESS_RADIUS = 25

# TROPHIES
TROPHY_CLEARANCE = 0.3
TROPHY_TOP_DEPTH = 32 + TROPHY_CLEARANCE
TROPHY_TOP_HEIGHT = 24 + TROPHY_CLEARANCE
TROPHY_BOT_DEPTH = 20 + TROPHY_CLEARANCE
TROPHY_BOT_HEIGHT = 7 + TROPHY_CLEARANCE
TROPHY_WIDTH = 9 + TROPHY_CLEARANCE
NO_TROPHY_TRAYS = 7
TROPHY_ACCESS_RADIUS = 10

# Chips
NO_CHIPS = 4
CHIP_CLEARANCE = 0.3
CHIP_RADIUS = 15 + CHIP_CLEARANCE
CHIP_HEIGHT = (7.5 + CHIP_CLEARANCE)*NO_CHIPS
CHIP_ACCESS_RADIUS = 7



# BOX LENGTH = 286
INSERTER_WIDTH = 105 
INSERTER_DEPTH = 210 # half of box length
INSERTER_HEIGHT = 66




@dataclass
class Cutout:
    position: App.Vector
    width: float
    height: float
    depth: float
    
    def get_shape(self):
        box = Part.makeBox(self.width, self.depth, self.height)
        box.translate(self.position)
        return box
        
@dataclass
class FingerAccess:
    position: App.Vector
    radius: float
    length: float
    direction: App.Vector
    
    def get_shape(self):
        cylinder = Part.makeCylinder(self.radius, self.length)
        if not self.direction == App.Vector(0, 0, 1):
            axis = App.Vector(0, 0, 1).cross(self.direction)
            angle = App.Vector(0, 0, 1).getAngle(self.direction)
            cylinder.rotate(App.Vector(0, 0, 0), axis, angle * 180 / pi)
        cylinder.translate(self.position)
        return cylinder
        
@dataclass
class CardCutout:
    position: App.Vector
    depth: float
    access: float
    
    def get_shape(self):
        box = Part.makeBox(CARD_WIDTH, self.depth, CARD_HEIGHT)
        access = FingerAccess(
            App.Vector(
                CARD_WIDTH/2,
                -self.access,
                CARD_HEIGHT,
            ),
            CARD_ACCESS_RADIUS,
            self.depth + self.access*2,
            App.Vector(0, 1, 0)
        )
        shape = box.fuse(access.get_shape())
        shape.translate(self.position)
        return shape

@dataclass
class TrophyCutout:
    position: App.Vector
    access:float
    
    def get_shape(self):
        top_position = App.Vector(
            0, 
            0, 
            TROPHY_BOT_HEIGHT
        )
        top = Cutout(
            top_position, 
            TROPHY_WIDTH, 
            TROPHY_TOP_HEIGHT,
            TROPHY_TOP_DEPTH, 
        )
        bot_position = App.Vector(
            0, 
            (TROPHY_TOP_DEPTH - TROPHY_BOT_DEPTH)/2, 
            0,
        )
        bot = Cutout(
            bot_position, 
            TROPHY_WIDTH, 
            TROPHY_BOT_HEIGHT, 
            TROPHY_BOT_DEPTH, 
        )
        access = FingerAccess(
            App.Vector(
                -self.access,
                TROPHY_TOP_DEPTH/2,
                TROPHY_TOP_HEIGHT + TROPHY_BOT_HEIGHT,
            ),
            TROPHY_ACCESS_RADIUS,
            TROPHY_WIDTH + self.access*2,
            App.Vector(1,0,0),
        ) 
        shape = top.get_shape().fuse(bot.get_shape()).fuse(access.get_shape())
        shape.translate(self.position)
        return shape


        
        

# =====================
# MAIN
# =====================

def main():
    doc = App.ActiveDocument
    if doc is None:
        doc = App.newDocument("ChallengerCardTrays")


    obj = doc.addObject("Part::Feature", "ChipInsert")
    chip_insert = get_chip_insert()
    chip_insert.translate(App.Vector(
        0,
        get_card_tray_depth(),
        get_trophy_tray_height()
    ))
    obj.Shape = chip_insert
    
    obj = doc.addObject("Part::Feature", "CardTrays")
    obj.Shape = get_card_and_trophy_insert()

def get_card_and_trophy_insert():
    insert = Part.makeBox(INSERTER_WIDTH, INSERTER_DEPTH, INSERTER_HEIGHT)
    
    card_cutouts, cards_depth = get_card_cutouts()
    card_cutouts.translate(App.Vector(
        (INSERTER_WIDTH - CARD_WIDTH)/2,
        SEPERATOR_WIDTH*2,
        BOTTOM_THICKNESS,
    ))
    insert = insert.cut(card_cutouts)
    
    trophy_cutouts, trophy_width = get_trophy_cutouts()
    trophy_cutouts.translate(App.Vector(
        (INSERTER_WIDTH - trophy_width)/2,
        (INSERTER_DEPTH - TROPHY_TOP_DEPTH + get_card_tray_depth())/2,
        BOTTOM_THICKNESS
    ))
    insert = insert.cut(trophy_cutouts)
    
    
    to_cut = Part.makeBox(INSERTER_WIDTH, INSERTER_DEPTH, INSERTER_HEIGHT)
    to_cut.translate(App.Vector(
        0,
        get_card_tray_depth(),
        get_trophy_tray_height(),
    ))
    insert = insert.cut(to_cut)
    return insert
    
def get_card_tray_depth():
    full_depth = 0
    no_card_depths = len(CARD_DEPTHS)
    for i in range(no_card_depths):
        full_depth = full_depth + CARD_DEPTHS[i] + SEPERATOR_WIDTH
    return full_depth + SEPERATOR_WIDTH*2 + 10
    
def get_trophy_tray_height():
    return BOTTOM_THICKNESS + TROPHY_TOP_HEIGHT + TROPHY_BOT_HEIGHT

def get_chip_insert():
    width = INSERTER_WIDTH
    depth = INSERTER_DEPTH - get_card_tray_depth()
    height = INSERTER_HEIGHT - (BOTTOM_THICKNESS + TROPHY_TOP_HEIGHT + TROPHY_BOT_HEIGHT)
    
    insert = Part.makeBox(width, depth, height)
    cutout, cutout_width = get_chip_cutout()
    cutout.translate(App.Vector(
        (INSERTER_WIDTH/2-cutout_width)/2,
        depth/2,
        height - CHIP_RADIUS,
    ))
    
    insert = insert.cut(cutout)
    return insert

# =====================
# CARD HOLDER
# =====================
def get_card_cutouts():
    access = 10
    full_depth = 0
    cutouts = []
    no_card_depths = len(CARD_DEPTHS)
    for i in range(no_card_depths):
        depth = CARD_DEPTHS[i]
        position = App.Vector(0, full_depth, 0)
        cutouts.append(
            CardCutout(
                position, 
                depth,
                access
            )
        )
        full_depth = full_depth +  depth + SEPERATOR_WIDTH
    shape = cutouts[0].get_shape()
    for i in range(1, no_card_depths):
        shape = shape.fuse(cutouts[i].get_shape())
    return shape, full_depth + SEPERATOR_WIDTH

# =====================
# TROPHIES HOLDER
# =====================
def get_trophy_cutouts():
    access = 10
    cutouts = []
    width = 0
    for i in range(NO_TROPHY_TRAYS):
        cutouts.append(
            TrophyCutout(
                App.Vector(width,0,0),
                access,
            )
        )
        width = width +  TROPHY_WIDTH + SEPERATOR_WIDTH
    shape = cutouts[0].get_shape()
    for i in range(1, NO_TROPHY_TRAYS):
        shape = shape.fuse(cutouts[i].get_shape())
    return shape, width-SEPERATOR_WIDTH

# =====================
# CHIP HOLDER
# =====================
def get_chip_cutout():
    access = 10
    shape = FingerAccess(
        App.Vector(access,0,0),
        CHIP_RADIUS,
        CHIP_HEIGHT,
        App.Vector(1,0,0),
    ).get_shape()
    
    box = Part.makeBox(CHIP_HEIGHT,CHIP_RADIUS*2,CHIP_RADIUS*2)
    box.translate(App.Vector(
        access,
        -CHIP_RADIUS,
        0,
    ))
    
    access_shape = FingerAccess(
        App.Vector(0,0,CHIP_RADIUS),
        CHIP_ACCESS_RADIUS,
        CHIP_HEIGHT + access,
        App.Vector(1,0,0),
    ) 
    
    shape = shape.fuse(box).fuse(access_shape.get_shape())
    return shape, CHIP_HEIGHT + access

# =====================
# ENTRY POINT
# =====================
if __name__ == "__main__":
    main()
