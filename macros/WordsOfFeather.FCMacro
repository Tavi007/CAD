def main():
    #C1 = App.Vector(0,0,0)
    #C2 = App.Vector(10,0,0)

    doc = App.ActiveDocument
    if doc is None:
        doc = App.newDocument("Base")
    
    
    
    #create_tear_shape(doc, C1, 19, C2, 6, 2)

    obj = doc.addObject("Part::Feature", "Base")
    obj.Shape = create_pen_gem_and_label_tray()
    doc.recompute()


def create_basic_tray(width, depth, height, with_finger_access):
    outer_box = Part.makeBox(width+2*WALL_THICKNESS, depth+2*WALL_THICKNESS, height+WALL_THICKNESS)
    inner_box = Part.makeBox(width, depth, height)
    
    translation = App.Vector(WALL_THICKNESS, WALL_THICKNESS, WALL_THICKNESS)
    inner_box = inner_box.translate(translation)
    outer_box = outer_box.cut(inner_box)
    
    if with_finger_access:
        finger_access = Part.makeBox(width/3, depth/4, height+WALL_THICKNESS)
        translation = App.Vector(width/3+WALL_THICKNESS, 0, 0)
        finger_access = finger_access.translate(translation)
        outer_box = outer_box.cut(finger_access)
    
    return outer_box
    
def create_bowl_and_card_tray():
    card_tray = create_basic_tray(CARD_TRAY_WIDTH, CARD_TRAY_DEPTH, TRAY_HEIGHT, False)
    bowl_tray = create_basic_tray(BOWL_WIDTH, BOWL_DEPTH, TRAY_HEIGHT, False)
    
    translation = App.Vector(CARD_TRAY_WIDTH+WALL_THICKNESS, 0, 0)
    bowl_tray = bowl_tray.translate(translation)
    tray = card_tray.fuse(bowl_tray)
    
    finger_access = Part.makeBox(CARD_TRAY_WIDTH/2+WALL_THICKNESS, CARD_TRAY_DEPTH/3, TRAY_HEIGHT+WALL_THICKNESS)
    translation = App.Vector(CARD_TRAY_WIDTH+WALL_THICKNESS/2-CARD_TRAY_WIDTH/4, CARD_TRAY_DEPTH/3+WALL_THICKNESS, 0)
    finger_access = finger_access.translate(translation)
    tray = tray.cut(finger_access)
    
    return tray
    
def create_pen_gem_and_label_tray():
    label_tray = create_basic_tray(LABEL_TRAY_WIDTH, LABEL_TRAY_DEPTH, TRAY_HEIGHT, False)
    pen_tray = create_basic_tray(PEN_TRAY_WIDTH, PEN_TRAY_DEPTH, TRAY_HEIGHT, False)
    gem_tray = create_basic_tray(GEM_TRAY_WIDTH, GEM_TRAY_DEPTH, TRAY_HEIGHT, False)
    
    translation = App.Vector(GEM_TRAY_WIDTH+WALL_THICKNESS, 0, 0)
    label_tray = label_tray.translate(translation)
    pen_tray = pen_tray.translate(translation)
    translation = App.Vector(0,LABEL_TRAY_DEPTH+WALL_THICKNESS, 0)
    pen_tray = pen_tray.translate(translation)
    tray = gem_tray.fuse(label_tray)
    tray = tray.fuse(pen_tray)
    
    finger_access = Part.makeBox(LABEL_TRAY_WIDTH/3, LABEL_TRAY_DEPTH/2+WALL_THICKNESS, TRAY_HEIGHT+WALL_THICKNESS)
    dx = GEM_TRAY_WIDTH + LABEL_TRAY_WIDTH/3
    dy = LABEL_TRAY_DEPTH*3/4 + WALL_THICKNESS/2 
    finger_access = finger_access.translate( App.Vector(dx, dy, 0))
    tray = tray.cut(finger_access)
    
    return tray
    
    
