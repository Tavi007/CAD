def create_stencils(input_dir: Path, output_dir: Path):
    print(f"start stencil creation of {input_dir}")
    base_path = input_dir / "base.txt"
    base_lattice_indices = read_lattice_indices(base_path)

    for stencil_path in input_dir.rglob("*.txt"):
        if not re.fullmatch(r"\d+\.txt", stencil_path.name):
            continue

        print(f" - start stencil creation of {stencil_path}")
        hole_lattice_indices = read_lattice_indices(stencil_path)
        stencil = create_shape_with_holes(
            GridType.PACKED, 
            base_lattice_indices, 
            hole_lattice_indices,
            RESOURCE_SIZE - 4 #just a bit smaller so resources won't fit in anymore
            )

        output_path = output_dir / stencil_path.name
        if stencil:
            save(stencil, output_path)
            print(f" - - stencil creation of {input} succeeded")
        else:
            print(f" - - stencil creation of {input} failed")


def create_board(input: Path):
    print(f"start tableau creation of {input}")
    lattice_indices = read_lattice_indices(input)
    tableau = create_shape_with_holes(
        GridType.PACKED,
        lattice_indices,
        lattice_indices,
        RESOURCE_SIZE+TOL
    )
    if tableau:
        save(tableau, input)
        print(f" - tableau creation of {input} succeeded")
    else:
        print(f" - tableau creation of {input} failed")
        
def create_resource(output: Path):
    hole = create_base_shape(
        ShapeType.CIRCLE, 
        RESOURCE_SIZE, 
        RESOURCE_SIZE, 
        HEIGHT-TOL
    )
    if hole:
        save(hole, output)
        print(f" - resource creation of {output} succeeded")
    else:
        print(f" - resource creation of {output} failed")
    


def save(shape, input: Path):
    input.parent.mkdir(parents=True, exist_ok=True)
    name = f"{input.parent}_{input.name}"
    doc = App.newDocument()
    obj = doc.addObject("Part::Feature", name)
    obj.Shape = shape
    doc.recompute()

    Mesh.export(
        [obj],
        str(input.with_suffix(".stl"))
    )
    App.closeDocument(doc.Name)


def read_lattice_indices(filename: Path) -> list[tuple[int, int]]:
    lattice_points = []
    with open(filename, "r") as f:
        for line in f:
            x_str, y_str = line.strip().split(",")
            lattice_points.append((int(x_str), int(y_str)))
    return lattice_points


def create_shape_with_holes(
    grid_type: GridType,
    hex_lattice_indices: list[tuple[int, int]],
    hole_lattice_indices: list[tuple[int, int]],
    hole_size: float
):
    hex_shapes = []
    for (i, j) in hex_lattice_indices:
        hex = create_base_shape(ShapeType.HEXAGON_POINTY,
                                UNIT_LENGTH*2/SQRT3, UNIT_LENGTH*2/SQRT3, HEIGHT)
        center = get_center(grid_type, i, j)
        hex.translate(center)
        hex_shapes.append(hex)

    holes = []
    for (i, j) in hole_lattice_indices:
        hole = create_base_shape(
            ShapeType.CIRCLE, 
            hole_size, 
            hole_size, 
            HEIGHT
        )
        center = get_center(grid_type, i, j)
        hole.translate(center)
        holes.append(hole)

    tableau = None
    for hex in hex_shapes:
        if not tableau:
            tableau = hex
        else:
            tableau = tableau.fuse(hex)
    for hole in holes:
        tableau = tableau.cut(hole)
        
    return shave_edges(tableau, grid_type, hex_lattice_indices)


def create_base_shape(shape_type: ShapeType, width: int, depth: int, height: int):
    board_shape = shape_type.get_board_shape(width, depth)
    if shape_type == ShapeType.CIRCLE:
        return Part.makeCylinder(board_shape.radius, height)
    else:
        polygon: Polygon = board_shape.to_shapely()
        points = [
            App.Vector(x, y, 0)
            for x, y in polygon.exterior.coords
        ]
        wire = Part.makePolygon(points)
        face = Part.Face(wire)
        return face.extrude(App.Vector(0, 0, height))


def get_center(grid_type: GridType, i: int, j: int):
    unit_vector = grid_type.get_unit_vector()
    steps = np.array([i, j])
    center = UNIT_LENGTH * unit_vector @ steps
    return App.Vector(center[0], center[1], 0.0)

    
def shave_edges(shape,
                grid_type: GridType,
                shape_lattice_indices: list[tuple[int, int]]):
    # Find min/max lattice indices in both directions
    imin = min(i for i, _ in shape_lattice_indices)
    imax = max(i for i, _ in shape_lattice_indices)
    jmin = min(j for _, j in shape_lattice_indices)
    jmax = max(j for _, j in shape_lattice_indices)

    for i in range(imin, imax + 1):
        for j in range(jmin, jmax + 1):
            if (i, j) not in shape_lattice_indices:
                hole = create_base_shape(
                    ShapeType.HEXAGON_POINTY,
                    UNIT_LENGTH + TOL,
                    UNIT_LENGTH + TOL,
                    HEIGHT,
                )

                center = get_center(grid_type, i, j)
                hole.translate(center)
                shape = shape.cut(hole)

    return shape
    


