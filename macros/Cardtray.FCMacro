import FreeCAD as App
import Part
from math import sqrt, pi
from dataclasses import dataclass
import itertools


# =====================
# PARAMETERS
# =====================

# printer
MAX_WIDTH = 220
MAX_DEPTH = 220
MAX_HEIGHT = 220

# card dimensions
CARD_WIDTH = 64.0
CARD_HEIGHT = 89.0
NO_CARDS = 100
CARD_DEPTH = 0.3
STACK_SIZE = NO_CARDS * CARD_DEPTH
CARD_TOLERANCE = 1
CARD_FILLET = 2

# magnet holes
ADD_MAGNETS = True
MAGNET_RADIUS = 1.5
MAGNET_DEPTH = 1.0
MAGNET_CLEARANCE = 0.3

# Tray
NO_TRAYS = 1
BUMP_HEIGHT = 1
SEPERATOR_WIDTH = 1

# outer hull
WALL_THICKNESS = SEPERATOR_WIDTH
if ADD_MAGNETS:
    minimum_thickness = (MAGNET_RADIUS + MAGNET_CLEARANCE) * 2 + 1
    WALL_THICKNESS = max(WALL_THICKNESS, minimum_thickness)
    SEPERATOR_WIDTH = MAGNET_DEPTH + MAGNET_CLEARANCE + 0.5

BOTTOM_THICKNESS = 2.5


# =====================
# DATA STRUCTURES
# =====================

@dataclass
class Cylinder:
    position: App.Vector
    radius: float
    height: float
    direction: App.Vector


# =====================
# MAIN
# =====================

def main():
    if NO_TRAYS < 1:
        return

    shape = create_card_holder()
    if not shape:
        print("Shape won't fit in the print volume!")
        return

    doc = App.ActiveDocument
    if doc is None:
        doc = App.newDocument("CardTrays")

    obj = doc.addObject("Part::Feature", "CardTrays")
    obj.Shape = shape
    doc.recompute()


# =====================
# CARD HOLDER
# =====================

def create_card_holder():
    tray_negative = create_card_tray_negatives()

    inner_width = CARD_WIDTH + CARD_TOLERANCE
    inner_depth = CARD_HEIGHT + CARD_TOLERANCE
    inner_height = STACK_SIZE

    outer_width = inner_width * NO_TRAYS + (NO_TRAYS + 1) * SEPERATOR_WIDTH
    outer_depth = inner_depth + 2 * WALL_THICKNESS
    outer_height = inner_height + BOTTOM_THICKNESS

    outer_box = Part.makeBox(outer_width, outer_depth, outer_height)

    # First tray
    translation = App.Vector(SEPERATOR_WIDTH, WALL_THICKNESS, BOTTOM_THICKNESS)
    tray_negative = tray_negative.translate(translation)
    outer_box = outer_box.cut(tray_negative)

    # Additional trays
    if NO_TRAYS > 1:
        for _ in range(NO_TRAYS - 1):
            tray_negative = tray_negative.translate(
                App.Vector(inner_width + SEPERATOR_WIDTH, 0, 0)
            )
            outer_box = outer_box.cut(tray_negative)

    if ADD_MAGNETS:
        outer_box = cut_magnet_holes(outer_box, outer_width, outer_depth, outer_height)

    print(f"Dimensions: {outer_width} x {outer_depth} x {outer_height} mm³")

    return outer_box


# =====================
# TRAY NEGATIVE
# =====================

def create_card_tray_negatives():
    width = CARD_WIDTH + CARD_TOLERANCE
    depth = CARD_HEIGHT + CARD_TOLERANCE
    height = STACK_SIZE + 10

    b_width = width / 2
    b_depth = depth / 8

    base = Part.makeBox(width, depth, height)

    cutout = Part.makeBox(b_width, b_depth, height)
    cutout = cutout.translate(App.Vector(b_width / 2, -b_depth / 2, 0))
    base = base.fuse(cutout)

    base = base.makeFillet(CARD_FILLET, base.Edges)

    bump = Part.makeBox(b_width, b_depth, BUMP_HEIGHT)
    bump = bump.translate(App.Vector(b_width / 2, b_depth * 2, 0))
    base = base.cut(bump)

    bump = bump.translate(App.Vector(0, b_depth * 3, 0))
    base = base.cut(bump)

    return base


# =====================
# MAGNET HOLES
# =====================

def cut_magnet_holes(card_holder, width, depth, height):
    cylinders = []
    cylinders.extend(create_corner_magnets(width, depth, height))
    cylinders.extend(create_side_wall_magnets(width, depth, height))

    for cyl in cylinders:
        hole = create_magnet_hole(cyl)
        card_holder = card_holder.cut(hole)

    return card_holder


def create_corner_magnets(width, depth, height):
    dx = WALL_THICKNESS / 2 + 0.75
    dy = WALL_THICKNESS / 2

    x_positions = [dx, width - dx]
    y_positions = [dy, depth - dy]
    z_positions = [0, height - MAGNET_DEPTH]

    cylinders = []
    for x, y, z in itertools.product(x_positions, y_positions, z_positions):
        cylinders.append(
            Cylinder(
                position=App.Vector(x, y, z),
                radius=MAGNET_RADIUS + MAGNET_CLEARANCE,
                height=MAGNET_DEPTH + MAGNET_CLEARANCE / 2,
                direction=App.Vector(0, 0, 1)
            )
        )
    return cylinders


def create_side_wall_magnets(width, depth, height):
    dx = SEPERATOR_WIDTH / 2
    dy = WALL_THICKNESS / 2
    
    
    z_position = height/2

    cx = width / 2
    cy = depth / 2

    specs = [
        (cx, dy, App.Vector(0, -1, 0)),   # front
        (cx, depth - dy, App.Vector(0, 1, 0)),  # back
        (dx, cy, App.Vector(-1, 0, 0)),  # left
        (width - dx, cy, App.Vector(1, 0, 0)),  # right
    ]

    cylinders = []
    for x, y, direction in specs:
        cylinders.append(
            Cylinder(
                position=App.Vector(x, y, z_position),
                radius=MAGNET_RADIUS + MAGNET_CLEARANCE,
                height=MAGNET_DEPTH + MAGNET_CLEARANCE / 2,
                direction=direction
            )
        )

    return cylinders


def create_magnet_hole(cylinder: Cylinder):
    hole = Part.makeCylinder(cylinder.radius, cylinder.height)

    if cylinder.direction != App.Vector(0, 0, 1):
        axis = App.Vector(0, 0, 1).cross(cylinder.direction)
        angle = App.Vector(0, 0, 1).getAngle(cylinder.direction)
        hole.rotate(App.Vector(0, 0, 0), axis, angle * 180 / pi)

    hole.translate(cylinder.position)
    return hole


# =====================
# ENTRY POINT
# =====================

if __name__ == "__main__":
    main()
