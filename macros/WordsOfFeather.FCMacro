# C1/C2 position
# R1/R2 radius 
def create_tear_shape(doc, C1, R1, C2, R2, h):
    sk = doc.addObject("Sketcher::SketchObject", "TearSketch")
    
    # Kreise
    c1_id = sk.addGeometry(Part.Circle(C1, App.Vector(0,0,1), R1), True)
    c2_id = sk.addGeometry(Part.Circle(C2, App.Vector(0,0,1), R2), True)
    
    # Punkte auf Kreisen
    p1 = C1 + App.Vector(0,R1,0)
    p2 = C2 + App.Vector(0,R2,0)
    
    p3 = C1 + App.Vector(0,-R1,0)
    p4 = C2 + App.Vector(0,-R2,0)
    
    p1_id, p2_id, l1_id = create_tangent_line(sk, c1_id, c2_id, p1, p2)
    p3_id, p4_id, l2_id = create_tangent_line(sk, c1_id, c2_id, p3, p4)
    
    create_arc(sk, c1_id, p1_id, p3_id)
    create_arc(sk, c2_id, p2_id, p4_id)
    
    doc.recompute()
    
    # Extrusion
    #face = Part.Face(sk.Shape.Wires[0])
    #solid = face.extrude(App.Vector(0, 0, h))
    #return solid
    
def create_tangent_line(sk, c1_id, c2_id, p1, p2):
    p1_id = sk.addGeometry(Part.Point(p1), False)
    p2_id = sk.addGeometry(Part.Point(p2), False)
    
    # Constraint: Punkt liegt auf Kreis
    sk.addConstraint(
        Sketcher.Constraint(
            "PointOnObject",
            p1_id, 1,      # Punkt, Vertex 1
            c1_id         # Kreis
        )
    )
    sk.addConstraint(
        Sketcher.Constraint(
            "PointOnObject",
            p2_id, 1,      # Punkt, Vertex 1
            c2_id          # Kreis
        )
    )

    # Linie (vorerst irgendwo)
    l_id = sk.addGeometry(Part.LineSegment(p1, p2), False)
    
    sk.addConstraint(
        Sketcher.Constraint(
            "Coincident",
            l_id, 1,
            p1_id, 1
        )
    )
    sk.addConstraint(
        Sketcher.Constraint(
            "Coincident",
            l_id, 2,
            p2_id, 1
        )
    )
    
    sk.addConstraint(
        Sketcher.Constraint(
            "Tangent",
            l_id,
            c1_id
        )
    )
    sk.addConstraint(
        Sketcher.Constraint(
            "Tangent",
                        l_id,
            c2_id
        )
    )
    return p1_id, p2_id, l_id
    
def create_arc(sk, circle_id, p1_id, p2_id):
    circle = sk.Geometry[circle_id]
    center = circle.Center
    radius = circle.Radius
    
    
    p1 = sk.Geometry[p1_id]
    p2 = sk.Geometry[p2_id]
    
    print(p1.X,p1.Y)
    print(p2.X,p2.Y)
    
    arc_id = sk.addGeometry(
        Part.ArcOfCircle(
            App.Vector(p1.X,p1.Y,0),
            center,
            App.Vector(p2.X,p2.Y,0),
        ),
        False
    )
