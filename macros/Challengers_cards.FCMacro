import FreeCAD as App
import Part
from math import sqrt, pi
from dataclasses import dataclass
import itertools

# =====================
# PARAMETERS
# =====================

# printer
MAX_WIDTH = 220
MAX_DEPTH = 220
MAX_HEIGHT = 220

# MAGNETS
MAGNET_CLEARANCE = 0.3
MAGNET_RADIUS = 3 + MAGNET_CLEARANCE
MAGNET_HEIGHT = 3 + MAGNET_CLEARANCE

# Tray
SEPERATOR_WIDTH = 1.5
BOTTOM_THICKNESS = 1.5
OUTER_WALL_DEPTH = MAGNET_HEIGHT + 1

# card dimensions
CARD_CLEARANCE = 1.3
CARD_WIDTH = 89.0 + CARD_CLEARANCE
CARD_HEIGHT = 64.0 + CARD_CLEARANCE
MAIN_CARD_DEPTHS = [36, 36, 26, 16, 3] # A, B, C cards, start decks, gameplay
MAIN_CARD_DEPTHS = [d + CARD_CLEARANCE for d in MAIN_CARD_DEPTHS] 
SUB_CARD_DEPTHS = [2, 8, 6] # solo, bot, trainer 
SUB_CARD_DEPTHS = [d + CARD_CLEARANCE for d in SUB_CARD_DEPTHS]
CARD_ACCESS_RADIUS = 25

# TROPHIES
# Space left for width: 135
# Space needed for trophies chip: 35 + clearance
TROPHY_CLEARANCE = 0.3
TROPHY_TOP_WIDTH = 35 + TROPHY_CLEARANCE
TROPHY_TOP_HEIGHT = 24 + TROPHY_CLEARANCE
TROPHY_BOT_WIDTH = 20 + TROPHY_CLEARANCE
TROPHY_BOT_HEIGHT = 7 + TROPHY_CLEARANCE
TROPHY_DEPTH = 9 + TROPHY_CLEARANCE
NO_TROPHY_TRAYS = 7
TROPHY_ACCESS_RADIUS = 10

# Chips
NO_CHIPS = 4
CHIP_CLEARANCE = 0.3
CHIP_RADIUS = 15 + CHIP_CLEARANCE
CHIP_HEIGHT = (7.5 + CHIP_CLEARANCE)*NO_CHIPS
CHIP_ACCESS_RADIUS = 7



# BOX LENGTH = 286
INSERTER_WIDTH = 135 
INSERTER_DEPTH = 143 # half of box length
INSERTER_HEIGHT = 66

SUB_INSERTER_WIDTH = 135 - sum(SUB_CARD_DEPTHS)
SUB_INSERTER_DEPTH = CARD_WIDTH + SEPERATOR_WIDTH*2
SUB_INSERTER_HEIGHT = 65




@dataclass
class Cutout:
    position: App.Vector
    width: float
    height: float
    depth: float
    
    def get_shape(self):
        box = Part.makeBox(self.width, self.depth, self.height)
        box.translate(self.position)
        return box
        
@dataclass
class FingerAccess:
    position: App.Vector
    radius: float
    length: float
    
    def get_shape(self):
        cylinder = Part.makeCylinder(self.radius, self.length)

        direction = App.Vector(0, 1, 0)
        axis = App.Vector(0, 0, 1).cross(direction)
        angle = App.Vector(0, 0, 1).getAngle(direction)
        cylinder.rotate(App.Vector(0, 0, 0), axis, angle * 180 / pi)
        cylinder.translate(self.position)
        return cylinder
        
@dataclass
class CardCutout:
    position: App.Vector
    depth: float
    access: float
    
    def get_shape(self):
        box = Part.makeBox(CARD_WIDTH, self.depth, CARD_HEIGHT)
        access = FingerAccess(
            App.Vector(
                CARD_WIDTH/2,
                -self.access,
                CARD_HEIGHT,
            ),
            CARD_ACCESS_RADIUS,
            self.depth + self.access*2,
        )
        shape = box.fuse(access.get_shape())
        shape.translate(self.position)
        return shape

@dataclass
class TrophyCutout:
    position: App.Vector
    depth: float
    access:float
    
    def get_shape(self):
        top_position = App.Vector(
            0, 
            0, 
            TROPHY_BOT_HEIGHT
        )
        top = Cutout(
            top_position, 
            TROPHY_TOP_WIDTH, 
            TROPHY_TOP_HEIGHT, 
            TROPHY_DEPTH,
        )
        bot_position = App.Vector(
            (TROPHY_TOP_WIDTH - TROPHY_BOT_WIDTH)/2, 
            0, 
            0
        )
        bot = Cutout(
            bot_position, 
            TROPHY_BOT_WIDTH, 
            TROPHY_BOT_HEIGHT, 
            TROPHY_DEPTH,
        )
        access = FingerAccess(
            App.Vector(
                TROPHY_TOP_WIDTH/2,
                -self.access,
                TROPHY_TOP_HEIGHT + TROPHY_BOT_HEIGHT,
            ),
            TROPHY_ACCESS_RADIUS,
            self.depth + self.access*2,
        ) 
        shape = top.get_shape().fuse(bot.get_shape()).fuse(access.get_shape())
        shape.translate(self.position)
        return shape


        
        

# =====================
# MAIN
# =====================

def main():
    shape = get_chip_insert()
    
    if not shape:
        print("Shape won't fit in the print volume!")
        return

    doc = App.ActiveDocument
    if doc is None:
        doc = App.newDocument("ChallengerCardTrays")


    obj = doc.addObject("Part::Feature", "ChipInsert")
    chip_insert = get_chip_insert()
    chip_insert.translate(App.Vector(
        get_card_tray_width(),
        0,
        get_trophy_tray_height()
    ))
    obj.Shape = chip_insert
    
    obj = doc.addObject("Part::Feature", "CardTrays")
    card_and_trophy_tray = get_card_and_trophy_insert()
    obj.Shape = card_and_trophy_tray

    obj = doc.addObject("Part::Feature", "CardTraysMirror")
    obj.Shape = mirror(card_and_trophy_tray)
    doc.recompute()

def get_card_and_trophy_insert():
    insert = Part.makeBox(INSERTER_WIDTH, INSERTER_DEPTH, INSERTER_HEIGHT)
    
    card_cutouts, cards_depth = get_card_cutouts()
    card_cutouts.translate(App.Vector(
        SEPERATOR_WIDTH,
        SEPERATOR_WIDTH*2,
        BOTTOM_THICKNESS,
    ))
    insert = insert.cut(card_cutouts)
    
    trophy_cutouts, trophies_depth = get_trophy_cutouts()
    card_tray_width = CARD_WIDTH + SEPERATOR_WIDTH*2 
    max_trophy_tray_depth = get_max_trophy_tray_depth()
    trophy_cutouts.translate(App.Vector(
        (INSERTER_WIDTH + card_tray_width - TROPHY_TOP_WIDTH)/2,
        (max_trophy_tray_depth - trophies_depth + SEPERATOR_WIDTH)/2,
        BOTTOM_THICKNESS
    ))
    insert = insert.cut(trophy_cutouts)
    
    
    to_cut = Part.makeBox(INSERTER_WIDTH, INSERTER_DEPTH, INSERTER_HEIGHT)
    to_cut.translate(App.Vector(
        get_card_tray_width(),
        max_trophy_tray_depth,
        0,
    ))
    insert = insert.cut(to_cut)
    to_cut.translate(App.Vector(
        0,
        -max_trophy_tray_depth,
        get_trophy_tray_height(),
    ))
    insert = insert.cut(to_cut)
    return insert
    
def get_card_tray_width():
    return CARD_WIDTH + SEPERATOR_WIDTH*2
    
def get_trophy_tray_height():
    return BOTTOM_THICKNESS + TROPHY_TOP_HEIGHT + TROPHY_BOT_HEIGHT
    
def get_max_trophy_tray_depth():
    return INSERTER_DEPTH - CARD_WIDTH/2 - SEPERATOR_WIDTH - MAGNET_HEIGHT*2

def get_chip_insert():
    width = INSERTER_WIDTH - (CARD_WIDTH+2*SEPERATOR_WIDTH)
    depth = get_max_trophy_tray_depth()
    height = INSERTER_HEIGHT - (BOTTOM_THICKNESS + TROPHY_TOP_HEIGHT + TROPHY_BOT_HEIGHT)
    
    insert = Part.makeBox(width, depth, height)
    cutout, cutout_depth = get_chip_cutout()
    cutout.translate(App.Vector(
        width/2,
        (depth-cutout_depth)/2,
        height - CHIP_RADIUS,
    ))
    
    insert = insert.cut(cutout)
    return insert

def mirror(shape): #this function mirrors in the XY plane if you don't add 'placement', see below
    # Spiegelebene: Ursprung + Normalenvektor
    mirror_plane_point = App.Vector(0, INSERTER_DEPTH + 0.1, 0)
    mirror_plane_normal = App.Vector(0, 1, 0)  # Y-Achse
    
    return shape.mirror(
        mirror_plane_point,
        mirror_plane_normal
    )

# =====================
# CARD HOLDER
# =====================
def get_card_cutouts():
    access = 5
    outer_depth = 0
    cutouts = []
    no_card_depths = len(MAIN_CARD_DEPTHS)
    for i in range(no_card_depths):
        depth = MAIN_CARD_DEPTHS[i]
        position = App.Vector(0, outer_depth, 0)
        cutouts.append(
            CardCutout(
                position, 
                depth,
                access
            )
        )
        outer_depth = outer_depth +  depth + SEPERATOR_WIDTH
    shape = cutouts[0].get_shape()
    for i in range(1, no_card_depths):
        shape = shape.fuse(cutouts[i].get_shape())
    return shape, outer_depth + SEPERATOR_WIDTH

# =====================
# TROPHIES HOLDER
# =====================
def get_trophy_cutouts():
    access = 5
    cutouts = []
    outer_depth = 0
    for i in range(NO_TROPHY_TRAYS):
        cutouts.append(
            TrophyCutout(
                App.Vector(0,outer_depth,0),
                TROPHY_DEPTH,
                access,
            )
        )
        outer_depth = outer_depth +  TROPHY_DEPTH + SEPERATOR_WIDTH
    shape = cutouts[0].get_shape()
    for i in range(1, NO_TROPHY_TRAYS):
        shape = shape.fuse(cutouts[i].get_shape())
    return shape, outer_depth

# =====================
# CHIP HOLDER
# =====================
def get_chip_cutout():
    access = SEPERATOR_WIDTH*3
    shape = FingerAccess(
        App.Vector(
            0,
            access,
            0,
        ),
        CHIP_RADIUS,
        CHIP_HEIGHT,
    ).get_shape()
    box = Part.makeBox(CHIP_RADIUS*2,CHIP_HEIGHT,CHIP_RADIUS*2)
    box.translate(App.Vector(-CHIP_RADIUS,access,0))
    shape = shape.fuse(box)
    access_shape = FingerAccess(
        App.Vector(
            0,
            0,
            CHIP_RADIUS,
        ),
        CHIP_ACCESS_RADIUS,
        CHIP_HEIGHT + access*2,
    ) 
    shape = shape.fuse(access_shape.get_shape())
    return shape, CHIP_HEIGHT + access*2

# =====================
# ENTRY POINT
# =====================
if __name__ == "__main__":
    main()
