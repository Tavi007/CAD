# printer
MAX_WIDTH = 220
MAX_DEPTH = 220
MAX_HEIGHT = 220

# Base
BASE_DEPTH = 212
BASE_WIDTH = 170.1
TRAY_HEIGHT = 34.5
WALL_THICKNESS = 0.7

# Bowl
BOWL_WIDTH = 103.5
BOWL_DEPTH = 115

# Card
CARD_TRAY_WIDTH = BASE_WIDTH - BOWL_WIDTH - 3*WALL_THICKNESS
CARD_TRAY_DEPTH = BOWL_DEPTH
CARD_R1 = 10
CARD_R2 = 5
CARD_R_DISTANCE = 13

# Label
LABEL_TRAY_WIDTH = 130
LABEL_TRAY_DEPTH = 40

# Pen
PEN_TRAY_WIDTH = LABEL_TRAY_WIDTH
PEN_TRAY_DEPTH = BASE_DEPTH - BOWL_DEPTH - LABEL_TRAY_DEPTH - 4*WALL_THICKNESS

# Gem
GEM_TRAY_WIDTH = BASE_WIDTH - LABEL_TRAY_WIDTH - 3*WALL_THICKNESS
GEM_TRAY_DEPTH = BASE_DEPTH - BOWL_DEPTH - 3*WALL_THICKNESS







